# --- CTFd target ---
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_xxxxxxxxxxxxxxxxxxxx

# --- safety ---
SCOPE_PATH=tools/ctf/scope.json
HITL_SUBMIT=true                 # queue flags for human approval (recommended)
AUTO_SUBMIT_CONSENSUS=2          # if HITL off, require N independent flags

# --- orchestration ---
POLL_INTERVAL=10
MAX_PARALLEL_CHALLENGES=4
MAX_STEPS=40
SOLVER_TIMEOUT=900

# --- sandbox ---
SANDBOX_IMAGE=ctf-sandbox
SANDBOX_NETWORK=none             # auto-bumped to bridge for remote challenges

# --- model lineup (raced per challenge) ---
# Set REAL model IDs from your provider (the names below are placeholders).
MODELS=anthropic:claude-sonnet-4-5,anthropic:claude-opus-4-1
# cross-provider racing also supported, e.g.:
# MODELS=anthropic:claude-sonnet-4-5,openai:gpt-5,gemini:gemini-2.5-pro

# --- API keys ---
ANTHROPIC_API_KEY=sk-ant-xxxx
OPENAI_API_KEY=
GEMINI_API_KEY=
