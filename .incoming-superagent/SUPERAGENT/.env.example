# ════════════════════════════════════════════════════════════════════
# SUPERAGENT v4.0 — OPENCLAW EDITION · .env.example
# Salin ke `.env`, isi yang lo butuh. Banyak yang OPSIONAL & banyak yang KEYLESS.
# Legend:  [WAJIB] harus diisi · [OPT] opsional · [FREE] gratis tanpa key · [PAID] berbayar
# ════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# 1. WALLET & VAULT  (inti — jaga ketat)
# ─────────────────────────────────────────────────────────────
HERMES_MASTER_PW=                 # [WAJIB] password enkripsi vault wallet (scrypt+Fernet)
PRIVATE_KEY=                      # [OPT] dipakai sk13 minter (single wallet). Lebih baik via vault.

# ─────────────────────────────────────────────────────────────
# 2. RPC ENDPOINTS  (per chain)  — public RPC FREE tapi rate-limited; pakai 2+ buat failover
# ─────────────────────────────────────────────────────────────
# Penamaan utama (Hermes references):
RPC_EVM_ETHEREUM=https://eth.llamarpc.com          # [FREE default]
RPC_EVM_BASE=https://mainnet.base.org              # [FREE default]
WS_RPC_EVM_ETHEREUM=                               # [OPT] websocket buat monitoring (mempool/event)
RPC_SOLANA=https://api.mainnet-beta.solana.com     # [FREE default, rate-limited]

# CATATAN: skill sk13 (minter) pakai NAMA VAR BEDA (legacy). Set ini juga kalau pakai sk13:
RPC_ETH=https://eth.llamarpc.com
RPC_BASE=https://mainnet.base.org
RPC_POLYGON=https://polygon-rpc.com
RPC_ARB=https://arb1.arbitrum.io/rpc
RPC_OP=https://mainnet.optimism.io
RPC_ZORA=https://rpc.zora.energy

# ─────────────────────────────────────────────────────────────
# 3. SPEND GOVERNOR — circuit breaker  (v4.0)  [semua OPT, tapi sangat disarankan]
# ─────────────────────────────────────────────────────────────
HERMES_MAX_TX_USD=500             # cap nilai 1 tx (butuh price oracle buat aktif)
HERMES_DAILY_CAP_USD=2000         # cap akumulasi 24 jam per wallet
HERMES_SESSION_CAP_USD=1000       # cap akumulasi per sesi
HERMES_MAX_SLIPPAGE_PCT=5         # tolak swap di atas ini
HERMES_MAX_GAS_MULTIPLE=4         # gas > Nx baseline → kill-switch HALT
HERMES_MAX_TX_PER_MIN=12          # runaway protection
HERMES_REQUIRE_SIM=1              # 1=wajib simulasi sebelum sign (0=matikan, TIDAK disarankan)
HERMES_GOVERNOR_DB=~/.hermes/governor.db
HERMES_KILLSWITCH=~/.hermes/HALT  # `touch` file ini = halt darurat manual

# ─────────────────────────────────────────────────────────────
# 4. MEV PROTECTION  (v4.0)  [OPT]
# ─────────────────────────────────────────────────────────────
HERMES_PRIVATE_RPC=               # custom private relay (kosong = pakai Flashbots/MEV Blocker default utk Ethereum)

# ─────────────────────────────────────────────────────────────
# 5. SKILL INTEGRITY  (v4.0)  [OPT — buat signed manifest]
# ─────────────────────────────────────────────────────────────
HERMES_SIGNING_KEY=               # path PEM Ed25519 buat tanda tangan SKILLS.lock (simpan di luar repo)
HERMES_VERIFY_KEY=                # path PEM public key buat verify
HERMES_PROPOSALS=~/.hermes/proposals
HERMES_REFLECTION_AUDIT=~/.hermes/reflection-audit.log

# ─────────────────────────────────────────────────────────────
# 6. BROWSER AUTOMATION  (v4.0)  [OPT]
# ─────────────────────────────────────────────────────────────
HERMES_BROWSER_PROFILE=~/.hermes/browser-profile   # profil persisten dApp (perlakukan sensitif)

# ─────────────────────────────────────────────────────────────
# 7. SELF-IMPROVE & MEMORY  (v4.0)  [OPT]
# ─────────────────────────────────────────────────────────────
HERMES_MEMORY_DB=~/.hermes/memory.db
HERMES_SESSION_ID=                # auto kalau kosong
HERMES_MODELS_DB=~/.hermes/models.db   # registry LLM dinamis (v4.0) — key dienkripsi pakai HERMES_MASTER_PW

# ─────────────────────────────────────────────────────────────
# 8. DAILY ASSISTANT  (v4.0)  [OPT]
# ─────────────────────────────────────────────────────────────
HERMES_ALERTS_DB=~/.hermes/alerts.db
HERMES_BRIEFING_STATE=~/.hermes/briefing-last.txt
HERMES_BOT_HEARTBEAT=~/.hermes/bot-heartbeat       # watchdog self-monitor
HERMES_VAULT_DB=~/.hermes/vault.db
HERMES_WHISPER_MODEL=base                          # tiny/base/small/medium (STT lokal gratis)
HERMES_AUTOMATION_DB=~/.hermes/automation.db       # event-driven automation (v4.0)
HERMES_TTS_OUT=/tmp/hermes_reply.wav               # output voice TTS (v4.0)

# ─────────────────────────────────────────────────────────────
# 9. NOTIFIER  (FREE — bot token gratis, bukan API berbayar)
# ─────────────────────────────────────────────────────────────
HERMES_TG_BOT_TOKEN=              # [FREE] dari @BotFather
HERMES_TG_CHAT_ID=               # [FREE] chat id target
HERMES_DISCORD_WEBHOOK=          # [FREE] webhook URL

# ─────────────────────────────────────────────────────────────
# 10. DATA / TRADING / NFT API  (sebagian PAID, sebagian punya free tier)
#     CATATAN: contract_reader/writer (v4.0) pakai Sourcify/Blockscout = KEYLESS.
#     DexScreener (alerts) & DefiLlama = KEYLESS. honeypot.is/GoPlus = free tier.
# ─────────────────────────────────────────────────────────────
ONEINCH_API_KEY=                 # [PAID] swap aggregator — https://portal.1inch.dev
RESERVOIR_API_KEY=               # [OPT] NFT aggregator — https://reservoir.tools
OPENSEA_API_KEY=                 # [OPT] sk13 OpenSea slug→contract (juga dipakai sbg OPENSEA_KEY)
OPENSEA_KEY=                     # [OPT] alias yang dipakai sk13 — isi sama dgn OPENSEA_API_KEY
ZERION_API_KEY_B64=              # [OPT] portfolio — base64('apikey:')
BIRDEYE_API_KEY=                 # [OPT] Solana token info
NANSEN_API_KEY=                  # [PAID] smart money (paling akurat)
ARKHAM_API_KEY=                  # [OPT] smart money (ada free tier)
DUNE_API_KEY=                    # [OPT] custom queries

# ─────────────────────────────────────────────────────────────
# 11. AI PROVIDER CASCADE  (R7 — fallback berurutan; isi minimal 1)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=               # 1st — reasoning terbaik
KIMI_API_KEY=                    # 2nd — long context, bahasa Asia
OPENROUTER_API_KEY=              # 3rd — multi-model fallback
DEEPSEEK_API_KEY=                # 4th — murah
GROQ_API_KEY=                    # 5th — cepat
OPENAI_API_KEY=                  # [OPT] alternatif / vision (screenshot input sk15)
TOGETHER_API_KEY=                # [OPT]
