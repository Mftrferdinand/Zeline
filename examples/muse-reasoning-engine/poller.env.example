# Poller environment — copy to /etc/muse-stack/poller.env (mode 0600) and fill in.
# NEVER commit real keys to git.

# OpenAI-compatible LLM endpoint the poller reasons through
MUSE_POLLER_BASE_URL=http://localhost:20128/v1
# API key for the endpoint above
MUSE_POLLER_API_KEY=
# Model id to request
MUSE_POLLER_MODEL=muse

# Optional tuning (defaults shown)
# MUSE_POLLER_INTERVAL=10
# MUSE_POLLER_STALE_SECS=220
# MUSE_POLLER_TRIM_BYTES=200000
# MUSE_POLLER_JSON_MODE=0
